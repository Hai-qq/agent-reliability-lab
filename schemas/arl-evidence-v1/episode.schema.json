{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "condition": {
      "minLength": 1,
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "type": "string"
    },
    "environment_seed": {
      "minimum": 0,
      "type": "integer"
    },
    "episode_id": {
      "minLength": 1,
      "type": "string"
    },
    "evaluator_clause_definitions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "clause_id": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "expected_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "operator": {
            "enum": [
              "digest_equals",
              "digest_not_equals"
            ]
          },
          "severity": {
            "minLength": 1,
            "type": "string"
          },
          "state_path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "clause_id",
          "description",
          "expected_digest",
          "operator",
          "severity",
          "state_path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evaluator_clause_outcomes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "clause_id": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_paths": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "observed_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "clause_id",
          "evidence_paths",
          "observed_digest",
          "passed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "execution_order_index": {
      "minimum": 0,
      "type": "integer"
    },
    "fault_family": {
      "minLength": 1,
      "type": "string"
    },
    "fault_injection_events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fault_family": {
            "minLength": 1,
            "type": "string"
          },
          "fault_id": {
            "minLength": 1,
            "type": "string"
          },
          "injection_point": {
            "minLength": 1,
            "type": "string"
          },
          "observable_symptom": {
            "minLength": 1,
            "type": "string"
          },
          "sequence_index": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "fault_family",
          "fault_id",
          "injection_point",
          "observable_symptom",
          "sequence_index"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "final_public_state": {
      "type": "object"
    },
    "final_state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "initial_public_state": {
      "type": "object"
    },
    "initial_state_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "logical_provider_call_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "model_binding": {
      "minLength": 1,
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_binding": {
      "minLength": 1,
      "type": "string"
    },
    "public_state_diff": {
      "type": "object"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime": {
      "minLength": 1,
      "type": "string"
    },
    "runtime_recovery_events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mechanism": {
            "minLength": 1,
            "type": "string"
          },
          "outcome": {
            "minLength": 1,
            "type": "string"
          },
          "related_call_id": {
            "minLength": 1,
            "type": "string"
          },
          "sequence_index": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "mechanism",
          "outcome",
          "related_call_id",
          "sequence_index"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "safe_success": {
      "type": "boolean"
    },
    "sampling_trial": {
      "minimum": 0,
      "type": "integer"
    },
    "schedule_block_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "arl-evidence-v1"
    },
    "semantic_decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision_type": {
            "minLength": 1,
            "type": "string"
          },
          "sequence_index": {
            "minimum": 0,
            "type": "integer"
          },
          "value": {}
        },
        "required": [
          "decision_type",
          "sequence_index",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "severe_side_effect_count": {
      "minimum": 0,
      "type": "integer"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "study_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_success": {
      "type": "boolean"
    },
    "task_template_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_version": {
      "minLength": 1,
      "type": "string"
    },
    "terminal_reason": {
      "minLength": 1,
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "arguments_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "call_id": {
            "minLength": 1,
            "type": "string"
          },
          "idempotency_key_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sequence_index": {
            "minimum": 0,
            "type": "integer"
          },
          "tool_name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "arguments_digest",
          "call_id",
          "idempotency_key_digest",
          "sequence_index",
          "tool_name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tool_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "minLength": 1,
            "type": "string"
          },
          "error_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sequence_index": {
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "call_id",
          "error_type",
          "result_digest",
          "sequence_index",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "trace_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "condition",
    "domain",
    "environment_seed",
    "episode_id",
    "evaluator_clause_definitions",
    "evaluator_clause_outcomes",
    "execution_order_index",
    "fault_family",
    "fault_injection_events",
    "final_public_state",
    "final_state_digest",
    "initial_public_state",
    "initial_state_digest",
    "logical_provider_call_ids",
    "model_binding",
    "policy_digest",
    "provider_binding",
    "public_state_diff",
    "request_digest",
    "runtime",
    "runtime_recovery_events",
    "safe_success",
    "sampling_trial",
    "schedule_block_id",
    "schema_version",
    "semantic_decisions",
    "severe_side_effect_count",
    "source_manifest_digest",
    "study_id",
    "task_success",
    "task_template_id",
    "task_version",
    "terminal_reason",
    "tool_calls",
    "tool_results",
    "trace_digest"
  ],
  "title": "ARL public episode v1",
  "type": "object"
}
